{
  "name": "@onenomad/przm-memory",
  "version": "1.2.0",
  "mcpName": "io.github.onenomad-llc/przm-memory",
  "description": "przm Memory — local-first memory MCP server for AI agents. Part of the przm AI reliability suite. LLM-powered extraction, hybrid ANN search, tier lifecycle, spreading activation, procedural rules, real-time ingest, and session-state.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./dist/server.js",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "przm-memory": "dist/server.js",
    "przm-memory-mcp": "dist/cli.js",
    "przm-memory-migrate": "dist/migrate.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneNomad-LLC/przm-memory.git"
  },
  "homepage": "https://github.com/OneNomad-LLC/przm-memory",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "node --import tsx benchmarks/bench.ts",
    "bench:verbose": "node --import tsx benchmarks/bench.ts --verbose",
    "bench:longmemeval": "node --import tsx benchmarks/longmemeval.ts",
    "bench:locomo": "node --import tsx benchmarks/locomo.ts",
    "bench:throughput": "node --import tsx benchmarks/ingest-throughput.ts",
    "bench:latency": "node --import tsx benchmarks/query-latency.ts",
    "bench:download": "bash benchmarks/download-datasets.sh",
    "bench:all": "node --import tsx benchmarks/bench-all.ts"
  },
  "dependencies": {
    "openai": "^4.80.0",
    "@huggingface/transformers": "^4.0.1",
    "@lancedb/lancedb": "^0.27.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "mem0ai": "^2.4.5"
  },
  "overrides": {
    "web-streams-polyfill": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
